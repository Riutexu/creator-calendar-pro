---
interface Props {
  dayName: string;
  class?: string;
}
const { dayName, class: className = '' } = Astro.props;
---
<div
  class={`absolute inset-0 bg-oled-black/60 backdrop-blur-sm flex items-center justify-center pointer-events-none ${className}`}
  role="status"
  aria-label={`Día inactivo: ${dayName}`}
>
  <div class="text-center p-4 animate-fade-in">
    <div class="text-4xl font-mono font-bold text-oled-neutral/50 mb-2" aria-hidden="true">🔒</div>
    <p class="text-text-muted font-sans text-sm">
      {dayName} inactivo
    </p>
    <p class="text-text-muted/60 text-xs font-mono mt-1">
      Actívalo en ⚙️ Configuración
    </p>
  </div>
</div>