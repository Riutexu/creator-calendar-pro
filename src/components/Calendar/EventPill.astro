---
interface Props {
  event: any;
  isSharedView?: boolean;
  class?: string;
}
const { event, isSharedView = false, class: className = '' } = Astro.props;
---
<div
  class={`pill-event relative z-10 mx-1 my-0.5 animate-scale-in ${className}`}
  data-event-id={event.id}
  data-game={event.gameName}
  style={`border-left: 3px solid ${event.color}; --pill-color: ${event.color};`}
  role="listitem"
  aria-label={`${event.title} - ${event.gameName}`}
  tabindex={isSharedView ? -1 : 0}
>
  <img
    src={event.gameCover}
    alt=""
    class="w-4 h-6 object-cover rounded-sm flex-shrink-0"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
    onerror="this.style.display='none'"
  />
  <span class="truncate max-w-[140px] font-mono text-pill font-medium text-white">
    {event.title}
  </span>
  <span class={`badge ${['badge-stream','badge-video','badge-event','badge-collab'][['stream','video','event','collab'].indexOf(event.type)] || 'badge-stream'} ml-1 flex-shrink-0`}>
    {event.type === 'stream' && '🔴'}
    {event.type === 'video' && '📹'}
    {event.type === 'event' && '📅'}
    {event.type === 'collab' && '🤝'}
  </span>

  {!isSharedView && (
    <button
      type="button"
      class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-oled-black/80 text-text-muted hover:text-white hover:bg-oled-light transition-all duration-fast flex items-center justify-center opacity-0 group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oled-light"
      aria-label={`Eliminar ${event.title}`}
      onclick={(e) => { e.stopPropagation(); window.deleteEvent?.(event.id); }}
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  )}

  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 bg-oled-elevated border border-oled-neutral rounded-card-sm text-xs font-mono text-text-secondary whitespace-nowrap opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-fast z-tooltip pointer-events-none" role="tooltip">
    <div class="font-medium text-white">{event.gameName}</div>
    <div>{event.title}</div>
    <div class="text-text-muted">{event.platforms.join(', ')}</div>
    {event.notes && <div class="truncate max-w-[200px]">{event.notes}</div>}
  </div>
</div>

<script is:inline>
  document.addEventListener('click', (e) => {
    const pill = e.target.closest('[data-event-id]');
    if (pill && !e.target.closest('button')) {
      const eventId = pill.getAttribute('data-event-id');
      window.openEventModal?.(eventId);
    }
  });
</script>