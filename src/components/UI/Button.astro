---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger' | 'outline';
  size?: 'sm' | 'lg';
  disabled?: boolean;
  class?: string;
  children: any;
}
const { type = 'button', variant = 'primary', size = 'md', disabled = false, class: className = '', children } = Astro.props;

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs gap-1.5',
  lg: 'px-6 py-3 text-base gap-2',
};

const variantClasses: Record<string, string> = {
  primary: 'bg-oled-light text-oled-black font-semibold shadow-[0_4px_16px_rgba(58,123,200,0.3)] hover:bg-opacity-90 hover:-translate-y-0.5 active:scale-[0.98]',
  secondary: 'bg-oled-dark text-white border border-oled-neutral hover:border-oled-light hover:bg-oled-dark-hover hover:shadow-[0_4px_16px_rgba(26,58,92,0.4)] active:scale-[0.98]',
  ghost: 'bg-transparent text-text-secondary hover:text-white hover:bg-oled-neutral/20',
  danger: 'bg-gradient-to-r from-rose-500 to-rose-600 text-white font-semibold shadow-[0_4px_16px_rgba(239,68,68,0.3)] hover:shadow-[0_8px_24px_rgba(239,68,68,0.4)] hover:-translate-y-0.5 active:scale-[0.98]',
  outline: 'bg-transparent border border-oled-neutral text-text-secondary hover:border-oled-light hover:bg-oled-neutral/20 active:bg-oled-neutral/40',
};