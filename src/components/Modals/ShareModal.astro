---
interface Props {
  isOpen: boolean;
  shareUrl: string;
  qrCodeDataUrl: string;
  username?: string;
  onClose: () => void;
  onCopyLink: () => void;
  onDownloadICS: () => void;
  onExportImage: () => void;
  onExportJSON: () => void;
  class?: string;
}
const { isOpen, shareUrl, qrCodeDataUrl, username, onClose, onCopyLink, onDownloadICS, onExportImage, onExportJSON, class: className = '' } = Astro.props;
---
{isOpen && (
  <div class="modal-backdrop" onclick={onClose} aria-hidden="true" />
)}

{isOpen && (
  <div class={`modal-content max-w-md mx-4 ${className}`} role="dialog" aria-modal="true" aria-labelledby="share-modal-title">
    <div class="p-4 border-b border-oled-neutral flex items-center justify-between">
      <h2 id="share-modal-title" class="font-display text-lg font-semibold text-white">Compartir Calendario</h2>
      <button type="button" class="btn-ghost p-2 rounded-full" onclick={onClose} aria-label="Cerrar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </div>

    <div class="p-4 space-y-4 max-h-[70vh] overflow-y-auto">
      <div class="text-center">
        <p class="text-sm text-text-secondary mb-3">Link de solo lectura para tu comunidad</p>
        <div class="flex items-center gap-2">
          <input
            type="text"
            id="share-url-input"
            class="input flex-1 text-xs font-mono bg-oled-black"
            value={shareUrl}
            readonly
            aria-label="URL para compartir"
          />
          <button
            type="button"
            class="btn-secondary whitespace-nowrap"
            onclick={onCopyLink}
            aria-label="Copiar link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
          </button>
        </div>
      </div>

      <div class="text-center">
        <p class="text-sm text-text-secondary mb-3">Escanea con el móvil</p>
        <img
          src={qrCodeDataUrl}
          alt="Código QR para compartir calendario"
          class="mx-auto w-48 h-48 image-rendering-pixelated"
        />
        <p class="text-xs text-text-muted mt-2">creator-calendar.pro/@{username || 'usuario'}</p>
      </div>

      <div class="border-t border-oled-neutral pt-4 space-y-2">
        <p class="text-sm font-medium text-text-secondary">Exportar</p>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="btn-secondary" onclick={onExportImage}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
            PNG
          </button>
          <button type="button" class="btn-secondary" onclick={onDownloadICS}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            .ics
          </button>
          <button type="button" class="btn-secondary" onclick={onExportJSON}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            JSON
          </button>
          <button type="button" class="btn-ghost" onclick={() => { navigator.share?.({ title: 'Mi Calendario', url: shareUrl }); onClose(); }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.58" y2="10.49" /></svg>
            Web Share
          </button>
        </div>
      </div>
    </div>
  </div>
)}