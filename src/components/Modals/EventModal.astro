---
interface Props {
  isOpen: boolean;
  event?: any;
  games?: any[];
  onClose: () => void;
  onSave: (data: any) => void;
  onDelete?: (id: string) => void;
  isSharedView?: boolean;
  class?: string;
}
const { isOpen, event, games = [], onClose, onSave, onDelete, isSharedView = false, class: className = '' } = Astro.props;

const isEditing = !!event;
const today = new Date().toISOString().split('T')[0];
---
{isOpen && (
  <div class="modal-backdrop" onclick={onClose} aria-hidden="true" />
)}

{isOpen && (
  <div class={`bottom-sheet ${className}`} role="dialog" aria-modal="true" aria-labelledby="event-modal-title">
    <div class="p-4 border-b border-oled-neutral flex items-center justify-between sticky top-0 bg-oled-dark z-10">
      <h2 id="event-modal-title" class="font-display text-lg font-semibold text-white">
        {isEditing ? 'Editar Evento' : 'Nuevo Evento'}
      </h2>
      <button
        type="button"
        class="btn-ghost p-2 rounded-full"
        onclick={onClose}
        aria-label="Cerrar modal"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <form id="event-form" class="p-4 space-y-4 max-h-[70vh] overflow-y-auto" onsubmit={(e) => { e.preventDefault(); handleSubmit(e); }}>
      <input type="hidden" name="id" value={event?.id || ''} />
      <input type="hidden" name="gameId" id="game-id-input" value={event?.gameId || ''} />
      <input type="hidden" name="gameCover" id="game-cover-input" value={event?.gameCover || ''} />
      <input type="hidden" name="gameHero" id="game-hero-input" value={event?.gameHero || ''} />

      <div>
        <label class="label" for="game-search">Juego</label>
        <div class="relative">
          <input
            type="text"
            id="game-search"
            name="gameSearch"
            class="input pr-12"
            placeholder="Buscar juego (R.E.P.O., Minecraft, RE4...)"
            value={event?.gameName || ''}
            autocomplete="off"
            required
            aria-describedby="game-search-help"
            {isSharedView && 'disabled'}
          />
          <button
            type="button"
            class="absolute right-3 top-1/2 -translate-y-1/2 btn-ghost p-1.5"
            onclick={() => window.openGameSearchModal?.()}
            aria-label="Buscar en SteamGridDB"
            {isSharedView && 'disabled'}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>
        </div>
        <p id="game-search-help" class="text-xs text-text-muted mt-1">Escribe para buscar en SteamGridDB o selecciona de la lista</p>
        <div id="game-suggestions" class="absolute z-dropdown w-full mt-1 hidden bg-oled-dark border border-oled-neutral rounded-card-sm overflow-hidden max-h-60 overflow-y-auto" role="listbox"></div>
      </div>

      <div id="selected-game-preview" class={`p-3 bg-oled-neutral/30 border border-oled-neutral rounded-card-sm ${event?.gameCover ? '' : 'hidden'}`}>
        <div class="flex items-center gap-3">
          <img id="preview-cover" src={event?.gameCover || ''} alt="" class="w-12 h-18 object-cover rounded-sm" />
          <div class="flex-1 min-w-0">
            <p class="font-medium text-white truncate" id="preview-name">{event?.gameName || ''}</p>
            <p class="text-xs text-text-muted font-mono" id="preview-type">Portada encontrada</p>
          </div>
          <button
            type="button"
            class="btn-ghost text-text-muted hover:text-white"
            onclick={() => clearGameSelection()}
            aria-label="Cambiar juego"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label" for="event-type">Tipo</label>
          <select id="event-type" name="type" class="input" {isSharedView && 'disabled'} required>
            <option value="stream" selected={event?.type === 'stream'}>🔴 Stream</option>
            <option value="video" selected={event?.type === 'video'}>📹 Video</option>
            <option value="event" selected={event?.type === 'event'}>📅 Evento</option>
            <option value="collab" selected={event?.type === 'collab'}>🤝 Colab</option>
          </select>
        </div>
        <div>
          <label class="label" for="event-date">Fecha</label>
          <input
            type="date"
            id="event-date"
            name="date"
            class="input"
            value={event?.start ? event.start.split('T')[0] : today}
            min={today}
            required
            {isSharedView && 'disabled'}
          />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="label" for="event-time">Hora inicio</label>
          <input
            type="time"
            id="event-time"
            name="startTime"
            class="input"
            value={event?.start ? event.start.split('T')[1].slice(0,5) : '20:00'}
            required
            {isSharedView && 'disabled'}
          />
        </div>
        <div>
          <label class="label" for="event-duration">Duración</label>
          <select id="event-duration" name="duration" class="input" {isSharedView && 'disabled'} required>
            <option value="30" selected={!event && 30 === 30}>30 min</option>
            <option value="60" selected={event && Math.round((new Date(event.end).getTime() - new Date(event.start).getTime())/60000) === 60 || (!event && 60 === 60)}>1 hora</option>
            <option value="90" selected={event && Math.round((new Date(event.end).getTime() - new Date(event.start).getTime())/60000) === 90}>1.5 horas</option>
            <option value="120" selected={event && Math.round((new Date(event.end).getTime() - new Date(event.start).getTime())/60000) === 120}>2 horas</option>
            <option value="180" selected={event && Math.round((new Date(event.end).getTime() - new Date(event.start).getTime())/60000) === 180}>3 horas</option>
            <option value="240" selected={event && Math.round((new Date(event.end).getTime() - new Date(event.start).getTime())/60000) === 240}>4 horas</option>
            <option value="300">5 horas</option>
            <option value="360">6 horas</option>
          </select>
        </div>
        <div class="col-span-3">
          <label class="label" for="event-title">Título del stream/evento</label>
          <input
            type="text"
            id="event-title"
            name="title"
            class="input"
            placeholder="First Run, Build Session, Cap 1, Co-op..."
            value={event?.title || ''}
            maxlength="80"
            required
            {isSharedView && 'disabled'}
          />
        </div>
      </div>

      <div>
        <label class="label flex items-center gap-2">
          Plataformas
          <span class="text-xs text-text-muted font-normal">(múltiple)</span>
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Plataformas de streaming">
          {['twitch','youtube','kick','tiktok','trovo','discord'].map(platform => (
            <label class="pill pill-tag cursor-pointer">
              <input
                type="checkbox"
                name="platforms"
                value={platform}
                class="sr-only peer"
                checked={event?.platforms?.includes(platform)}
                {isSharedView && 'disabled'}
              />
              <span class="capitalize">{platform}</span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label class="label" for="event-notes">Notas (opcional)</label>
        <textarea
          id="event-notes"
          name="notes"
          class="input min-h-[80px] resize-y font-sans text-sm"
          placeholder="Sin spoilers pls, primera vez que juego, horario especial..."
          value={event?.notes || ''}
          rows={3}
          {isSharedView && 'disabled'}
        ></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-oled-neutral sticky bottom-0 bg-oled-dark/95 backdrop-blur-sm mt-4">
        <button
          type="button"
          class="btn-secondary"
          onclick={onClose}
          {isSharedView && 'disabled'}
        >
          Cancelar
        </button>
        {isEditing && !isSharedView && onDelete && (
          <button
            type="button"
            class="btn-danger"
            onclick={() => { onDelete(event.id); onClose(); }}
          >
            Eliminar
          </button>
        )}
        <button
          type="submit"
          class="btn-primary"
          {isSharedView && 'disabled'}
        >
          {isEditing ? 'Guardar Cambios' : 'Crear Evento'}
        </button>
      </div>
    </form>
  </div>
)}

<script is:inline>
  function handleSubmit(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const data = {
      id: formData.get('id') || '',
      gameId: formData.get('gameId') || '',
      gameName: formData.get('gameSearch') || '',
      gameCover: formData.get('gameCover') || '',
      gameHero: formData.get('gameHero') || '',
      type: formData.get('type') as any,
      title: formData.get('title') || '',
      date: formData.get('date') || '',
      startTime: formData.get('startTime') || '',
      durationMinutes: parseInt(formData.get('duration') as string),
      platforms: formData.getAll('platforms') as any[],
      notes: formData.get('notes') || '',
    };

    if (!data.gameId || !data.gameCover) {
      window.toastError?.('Selecciona un juego válido');
      return;
    }

    if (!data.title.trim()) {
      window.toastError?.('El título es obligatorio');
      return;
    }

    if (data.platforms.length === 0) {
      window.toastError?.('Selecciona al menos una plataforma');
      return;
    }

    onSave(data);
  }

  function clearGameSelection() {
    document.getElementById('game-id-input')!.value = '';
    document.getElementById('game-cover-input')!.value = '';
    document.getElementById('game-hero-input')!.value = '';
    document.getElementById('game-search')!.value = '';
    document.getElementById('selected-game-preview')!.classList.add('hidden');
  }

  const searchInput = document.getElementById('game-search') as HTMLInputElement;
  const suggestions = document.getElementById('game-suggestions')!;

  let searchTimeout: number;
  searchInput?.addEventListener('input', async (e) => {
    clearTimeout(searchTimeout);
    const query = (e.target as HTMLInputElement).value.trim();

    if (query.length < 2) {
      suggestions.classList.add('hidden');
      return;
    }

    searchTimeout = window.setTimeout(async () => {
      try {
        const { searchGames } = await import('/src/lib/steamgriddb.ts');
        const config = await (await import('/src/lib/idb.ts')).getConfig();
        if (!config?.steamGridDbKey) {
          showLocalSuggestions(query);
          return;
        }

        const client = (await import('/src/lib/steamgriddb.ts')).createSteamGridDBClient(config.steamGridDbKey);
        const results = await client.searchGames(query);
        renderSuggestions(results.slice(0, 8));
      } catch {
        showLocalSuggestions(query);
      }
    }, 300);
  });

  function showLocalSuggestions(query: string) {
    const { POPULAR_GAMES_FALLBACK } = await import('/src/lib/steamgriddb.ts');
    const filtered = POPULAR_GAMES_FALLBACK
      .filter(g => g.name.toLowerCase().includes(query.toLowerCase()))
      .slice(0, 8);
    renderLocalSuggestions(filtered);
  }

  function renderSuggestions(games: any[]) {
    if (games.length === 0) {
      suggestions.classList.add('hidden');
      return;
    }

    suggestions.innerHTML = games.map(game => `
      <button type="button" class="w-full px-3 py-2 text-left hover:bg-oled-neutral flex items-center gap-3 transition-colors" data-game-id="${game.id}" data-game-name="${game.name}" role="option">
        <div class="w-8 h-12 bg-oled-neutral rounded-sm flex-shrink-0" style="background: linear-gradient(135deg, #0A1628, #1A3A5C);"></div>
        <span class="font-mono text-sm text-white truncate">${game.name}</span>
      </button>
    `).join('');

    suggestions.classList.remove('hidden');
    suggestions.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => selectGame(btn.dataset.gameId!, btn.dataset.gameName!));
    });
  }

  function renderLocalSuggestions(games: any[]) {
    if (games.length === 0) {
      suggestions.classList.add('hidden');
      return;
    }

    suggestions.innerHTML = games.map(game => `
      <button type="button" class="w-full px-3 py-2 text-left hover:bg-oled-neutral flex items-center gap-3 transition-colors" data-game-name="${game.name}" role="option">
        <div class="w-8 h-12 bg-oled-neutral rounded-sm flex-shrink-0" style="background: linear-gradient(135deg, #0A1628, #1A3A5C);"></div>
        <span class="font-mono text-sm text-white truncate">${game.name}</span>
        <span class="text-xs text-text-muted">Local</span>
      </button>
    `).join('');

    suggestions.classList.remove('hidden');
    suggestions.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => selectLocalGame(btn.dataset.gameName!));
    });
  }

  async function selectGame(gameId: string, gameName: string) {
    const config = await (await import('/src/lib/idb.ts')).getConfig();
    if (!config?.steamGridDbKey) return;

    const client = (await import('/src/lib/steamgriddb.ts')).createSteamGridDBClient(config.steamGridDbKey);
    const cover = await client.getBestCover(parseInt(gameId));

    if (cover.grid) {
      document.getElementById('game-id-input')!.value = gameId;
      document.getElementById('game-cover-input')!.value = cover.grid;
      document.getElementById('game-hero-input')!.value = cover.hero || '';
      document.getElementById('game-search')!.value = gameName;
      document.getElementById('preview-cover')!.setAttribute('src', cover.grid);
      document.getElementById('preview-name')!.textContent = gameName;
      document.getElementById('selected-game-preview')!.classList.remove('hidden');
      suggestions.classList.add('hidden');
    }
  }

  function selectLocalGame(gameName: string) {
    document.getElementById('game-search')!.value = gameName;
    document.getElementById('game-id-input')!.value = 'local-' + gameName.toLowerCase().replace(/\s+/g, '-');
    document.getElementById('game-cover-input')!.value = '';
    document.getElementById('game-hero-input')!.value = '';
    document.getElementById('preview-cover')!.setAttribute('src', '');
    document.getElementById('preview-name')!.textContent = gameName;
    document.getElementById('selected-game-preview')!.classList.remove('hidden');
    suggestions.classList.add('hidden');
  }

  document.addEventListener('click', (e) => {
    if (!suggestions.contains(e.target as Node) && e.target !== searchInput) {
      suggestions.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      onClose();
    }
  });
</script>