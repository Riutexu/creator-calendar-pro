---
interface Props {
  apiKey?: string;
  onSave: (key: string) => void;
  onTest: () => void;
  isTesting?: boolean;
  class?: string;
}
const { apiKey = '', onSave, onTest, isTesting = false, class: className = '' } = Astro.props;
---
<fieldset class={`space-y-4 ${className}`}>
  <legend class="label">SteamGridDB API Key</legend>
  <p class="text-xs text-text-muted">
    Obtén tu key gratis en <a href="https://www.steamgriddb.com/profile/preferences/api" target="_blank" rel="noopener" class="text-oled-light hover:underline">steamgriddb.com/profile/preferences/api</a>.
    Permite buscar portadas y banners oficiales de juegos.
  </p>

  <div class="relative">
    <input
      type="password"
      id="api-key"
      class="input pr-24 font-mono text-xs"
      placeholder="sk_********************"
      value={apiKey}
      autocomplete="off"
      aria-describedby="api-key-help"
    />
    <button
      type="button"
      class="absolute right-2 top-1/2 -translate-y-1/2 btn-ghost p-1.5 text-text-muted hover:text-white"
      onclick={() => {
        const input = document.getElementById('api-key') as HTMLInputElement;
        input.type = input.type === 'password' ? 'text' : 'password';
      }}
      aria-label="Mostrar/ocultar key"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </button>
  </div>
  <p id="api-key-help" class="text-xs text-text-muted">La key se guarda localmente en tu navegador (encriptada). Nunca sale de tu dispositivo.</p>

  <div class="flex gap-2">
    <button
      type="button"
      class="btn-secondary flex-1"
      onclick={() => onSave((document.getElementById('api-key') as HTMLInputElement).value)}
    >
      Guardar Key
    </button>
    <button
      type="button"
      class="btn-primary flex-1"
      onclick={onTest}
      disabled={isTesting}
    >
      {isTesting ? (
        <>
          <svg class="animate-spin-slow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25" />
            <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1" stroke-linecap="round" />
          </svg>
          Probando...
        </>
      ) : (
        'Probar Conexión'
      )}
    </button>
  </div>

  <div id="api-key-status" class="text-xs text-text-muted min-h-[20px]" aria-live="polite"></div>
</fieldset>