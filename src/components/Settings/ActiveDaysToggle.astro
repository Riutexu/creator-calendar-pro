---
interface Props {
  activeDays: number[];
  onToggleDay: (day: number) => void;
  class?: string;
}
const { activeDays = [], onToggleDay, class: className = '' } = Astro.props;

const dayOrder = [1, 2, 3, 4, 5, 6, 0];
const dayLabels = ['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB', 'DOM'];
---
<fieldset class={`space-y-4 ${className}`}>
  <legend class="label">Días de Stream</legend>
  <p class="text-xs text-text-muted">Click para activar/desactivar. Los días inactivos se muestran grises en el calendario.</p>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Días de la semana">
    {dayOrder.map((day, index) => {
      const isActive = activeDays.includes(day);
      return (
        <button
          type="button"
          class={`pill pill-active-day transition-all duration-fast min-w-[56px] ${isActive ? 'pill-active-day' : 'pill-inactive-day'}`}
          onclick={() => onToggleDay(day)}
          aria-pressed={isActive}
          aria-label={`${dayLabels[index]}: ${isActive ? 'Activo' : 'Inactivo'}`}
          data-day={day}
        >
          <span class="font-mono text-pill font-medium">{dayLabels[index]}</span>
          <span class={`w-2 h-2 rounded-full ${isActive ? 'bg-oled-light' : 'bg-oled-neutral'}`} aria-hidden="true" />
        </button>
      )
    })}
  </div>
</fieldset>