---
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  noIndex?: boolean;
}

const { title = 'Creator Calendar Pro', description, canonicalURL, noIndex } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A1628" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description || 'Calendario OLED para creadores de contenido'} />
    <link rel="canonical" href={canonicalURL || 'https://riutexu.github.io/creator-calendar-pro/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || 'Calendario OLED para creadores de contenido'} />
    <meta property="og:url" content={canonicalURL || 'https://riutexu.github.io/creator-calendar-pro/'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || 'Calendario OLED para creadores de contenido'} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="manifest" href="/creator-calendar-pro/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/creator-calendar-pro/icons/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/creator-calendar-pro/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/creator-calendar-pro/icons/icon-192.png" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/creator-calendar-pro/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-oled-black text-white font-sans antialiased">
    <slot />
  </body>
</html>