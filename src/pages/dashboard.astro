---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getConfig, getAllEvents } from '@/lib/idb';
import { getWeekNumber } from '@/lib/calendar';
import { DEFAULT_CONFIG } from '@/types';

const config = await getConfig() || DEFAULT_CONFIG;
const events = await getAllEvents();

const weekNumber = getWeekNumber(new Date());
const totalEvents = events.length;
const totalHours = events.reduce((sum, e) => {
  const start = new Date(e.start);
  const end = new Date(e.end);
  return sum + (end.getTime() - start.getTime()) / (1000 * 60 * 60);
}, 0);

const streams = events.filter(e => e.type === 'stream').length;
const videos = events.filter(e => e.type === 'video').length;
const eventsCount = events.filter(e => e.type === 'event').length;
const collabs = events.filter(e => e.type === 'collab').length;

const games = events.reduce((acc, e) => {
  acc[e.gameName] = (acc[e.gameName] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const topGames = Object.entries(games)
  .sort(([,a], [,b]) => b - a)
  .slice(0, 5);
---

<BaseLayout
  title="Dashboard — Creator Calendar Pro"
  description="Tu panel de control con estadísticas de streaming"
  canonicalURL="https://riutexu.github.io/creator-calendar-pro/dashboard"
>
  <header class="sticky top-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-b border-oled-neutral px-4 py-3 flex items-center justify-between">
    <a href="/" class="btn-ghost p-2 rounded-full" aria-label="Volver al calendario">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <h1 class="font-display text-xl font-bold text-white flex-1 text-center">📊 Dashboard</h1>
    <div class="w-10" />
  </header>

  <main class="p-4 max-w-7xl mx-auto space-y-6 pb-20" role="main">
    <!-- Welcome Header -->
    <div class="card-elevated p-6 rounded-2xl bg-gradient-to-r from-oled-dark to-oled-black border border-oled-neutral/50">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-oled-light/20 flex items-center justify-center text-oled-light">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 6v6m0 0v6" /></svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-white">Bienvenido de vuelta</h1>
          <p class="text-sm text-text-secondary">Semana ${weekNumber} · ${totalEvents} evento${totalEvents !== 1 ? 's' : ''} esta semana</p>
        </div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card-elevated p-4 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs text-text-muted font-mono uppercase">Eventos Totales</p>
            <h3 class="text-2xl font-bold text-white">${totalEvents}</h3>
          </div>
          <div class="w-10 h-10 rounded-lg bg-oled-light/20 flex items-center justify-center text-oled-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          </div>
        </div>
      </div>
      <div class="card-elevated p-4 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs text-text-muted font-mono uppercase">Horas Totales</p>
            <h3 class="text-2xl font-bold text-white">${totalHours.toFixed(1)}h</h3>
          </div>
          <div class="w-10 h-10 rounded-lg bg-oled-light/20 flex items-center justify-center text-oled-light">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 12" /></svg>
          </div>
        </div>
      </div>
      <div class="card-elevated p-4 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs text-text-muted font-mono uppercase">Streams</p>
            <h3 class="text-2xl font-bold text-white">${streams}</h3>
          </div>
          <div class="w-10 h-10 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
          </div>
        </div>
      </div>
      <div class="card-elevated p-4 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs text-text-muted font-mono uppercase">Videos</p>
            <h3 class="text-2xl font-bold text-white">${videos}</h3>
          </div>
          <div class="w-10 h-10 rounded-lg bg-violet-500/20 flex items-center justify-center text-violet-400">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 20a1 1 0 01-1-1V6.4l7-3.2 7 3.2V19a1 1 0 01-1 1z" /></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Games Chart -->
      <div class="card-elevated p-4 rounded-xl col-span-1 lg:col-span-2">
        <h3 class="text-lg font-bold text-white mb-4">Juegos más streamados</h3>
        <div class="h-48 flex items-end gap-2 px-4">
          {topGames.map(([game, count]) => {
            const percentage = totalEvents > 0 ? (count / totalEvents) * 100 : 0;
            return `
            <div class="flex-1 flex flex-col items-end justify-end gap-1 group">
              <div class="w-full bg-oled-neutral/30 rounded-t-lg transition-all duration-300 group-hover:bg-oled-light/50" style="height: ${percentage}%">
                <span class="absolute -top-6 right-0 text-[10px] text-text-muted">${count}</span>
              </div>
              <span class="text-[10px] text-text-muted truncate w-full">${game}</span>
            </div>
            `;
          }).join('')}
        </div>
      </div>

      <!-- Event Types -->
      <div class="card-elevated p-4 rounded-xl">
        <h3 class="text-lg font-bold text-white mb-4">Tipos de Evento</h3>
        <div class="space-y-4">
          {[['stream', streams, '🔴'], ['video', videos, '📹'], ['event', eventsCount, '📅'], ['collab', collabs, '🤝']].map(([type, count, icon]) => {
            const percentage = totalEvents > 0 ? (count / totalEvents) * 100 : 0;
            return `
            <div class="flex items-center justify-between p-3 rounded-lg bg-oled-dark/50 border border-oled-neutral/30">
              <div class="flex items-center gap-3">
                <span class="text-xl">${icon}</span>
                <span class="text-sm text-text-secondary capitalize">${type}</span>
              </div>
              <div class="flex flex-col items-end">
                <span class="text-sm font-bold text-white">${count}</span>
                <div class="w-24 h-1 bg-oled-neutral/30 rounded-full mt-1 overflow-hidden">
                  <div class="h-full bg-oled-light" style="width: ${percentage}%"></div>
                </div>
              </div>
            </div>
            `;
          }).join('')}
        </div>
      </div>
    </div>

    <!-- Recent Events -->
    <div class="card-elevated p-4 rounded-xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-white">Eventos Recientes</h3>
        <a href="/calendar" class="btn-ghost btn-sm text-xs">Ver todos los eventos</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="text-xs text-text-muted border-b border-oled-neutral/30">
              <th class="py-2">Juego</th>
              <th class="py-2">Título</th>
              <th class="py-2">Fecha</th>
              <th class="py-2">Hora</th>
              <th class="py-2">Tipo</th>
            </tr>
          </thead>
          <tbody>
            {events.slice(0, 10).map(event => {
              const start = new Date(event.start);
              const dateStr = start.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' });
              const timeStr = start.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
              return `
              <tr class="border-b border-oled-neutral/20 hover:bg-oled-neutral/10 transition-colors">
                <td class="py-2 text-xs font-mono text-text-secondary">
                  <span class="inline-flex items-center gap-2">
                    ${event.gameCover ? `<img src="${event.gameCover}" class="w-8 h-12 object-cover rounded-sm" alt="${event.gameName}" />` : `<div class="w-8 h-12 bg-oled-neutral rounded-sm flex items-center justify-center text-[10px]">${event.gameName[0]}</div>`}
                    ${event.gameName}
                  </span>
                </td>
                <td class="py-2 text-xs font-mono text-white truncate">${event.title}</td>
                <td class="py-2 text-xs font-mono text-text-secondary">${dateStr}</td>
                <td class="py-2 text-xs font-mono text-text-secondary">${timeStr}</td>
                <td class="py-2">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${event.type === 'stream' ? 'bg-emerald-500/20 text-emerald-400' : event.type === 'video' ? 'bg-violet-500/20 text-violet-400' : event.type === 'event' ? 'bg-amber-500/20 text-amber-400' : 'bg-rose-500/20 text-rose-400'}">
                    ${event.type}
                  </span>
                </td>
              </tr>
              `;
            }).join('')}
            ${events.length === 0 ? `<tr><td class="py-4 text-center text-text-muted" colspan="5">No hay eventos programados todavía.</td></tr>` : ''}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>