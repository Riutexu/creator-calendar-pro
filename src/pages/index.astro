---
import Layout from '@/layouts/BaseLayout.astro';

const features = [
  {
    icon: '🎨',
    title: 'Estética OLED Gaming',
    description: 'Diseño puro negro con paleta azul gaming. Optimizado para pantallas OLED y modos oscuros.',
  },
  {
    icon: '📅',
    title: 'Calendario Semanal/Diario',
    description: 'Vista semanal con franjas horarias y vista diaria detallada. Tu streaming bajo control.',
  },
  {
    icon: '🎮',
    title: 'SteamGridDB Integrado',
    description: 'Portadas y banners oficiales de juegos automáticamente desde SteamGridDB.',
  },
  {
    icon: '🔄',
    title: 'Eventos Recurrentes',
    description: 'Configura streams semanales, mensuales o personalizados que se repiten automáticamente.',
  },
  {
    icon: '📸',
    title: 'Exportar PNG/JPG',
    description: 'Genera imágenes de tu calendario para compartir en redes sociales con un clic.',
  },
  {
    icon: '🔗',
    title: 'Compartir Read-Only',
    description: 'Genera enlaces públicos para tu comunidad sin dar acceso de edición.',
  },
  {
    icon: '📱',
    title: 'PWA Instalable',
    description: 'Instala como app nativa en Windows, Mac, Linux, Android e iOS. Funciona offline.',
  },
  {
    icon: '🔐',
    title: '100% Privado y Gratis',
    description: 'Todo en tu navegador (IndexedDB). Sin servidores, sin tracking, sin pagos, para siempre.',
  },
];

const pricing = [
  {
    name: 'Gratis para Siempre',
    price: '0€',
    period: '/mes',
    features: [
      'Calendario semanal y diario',
      'Días de streaming personalizables',
      'Integración SteamGridDB',
      'Exportar PNG/JPG',
      'Compartir read-only',
      'PWA instalable',
      'Eventos recurrentes',
      'Notificaciones',
      'Exportar ICS/JSON',
    ],
    highlighted: false,
  },
  {
    name: 'Pro',
    price: '0€',
    period: '/mes',
    features: [
      'Todo de Gratis',
      'Sincronización multi-dispositivo',
      'Colaboración en equipo',
      'Temas de color personalizados',
      'Soporte prioritario',
    ],
    highlighted: true,
    note: 'También gratis. Porque creamos esto para la comunidad.',
  },
];

const faqs = [
  {
    q: '¿Es realmente gratis?',
    a: 'Sí, 100% gratis. No hay suscripciones, no hay pagos ocultos. Todo se guarda en tu navegador.',
  },
  {
    q: '¿Necesito cuenta?',
    a: 'No. Todo funciona en tu navegador. Puedes exportar tus datos en cualquier momento.',
  },
  {
    q: '¿Qué es SteamGridDB?',
    a: 'Es el sitio oficial de la comunidad aprobado por Steam para portadas y banners de juegos.',
  },
  {
    q: '¿Puedo usarlo en móvil?',
    "Sí, es una PWA. Instálalo como app en cualquier dispositivo y funciona offline.",
  },
];

---

<Layout title="Creator Calendar Pro — Calendario para Streamers y Creadores">
  <!-- Hero Section -->
  <section class="relative min-h-[70vh] flex flex-col items-center justify-center px-4 py-16 overflow-hidden">
    <!-- Background gradient mesh -->
    <div class="absolute inset-0 bg-gradient-to-tr from-oled-dark/80 to-black opacity-80" />
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-oled-light/10 rounded-full blur-[100px] animate-pulse" />
    <div class="absolute bottom-0 right-1/2 translate-x-1/2 w-[600px] h-[600px] bg-oled-accent/10 rounded-full blur-[100px] animate-pulse" style="animation-delay: 2s;" />

    <div class="relative z-10 text-center max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-oled-neutral/30 border border-oled-neutral/50 rounded-full text-xs font-mono text-oled-light mb-6 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-oled-light animate-pulse"></span>
        <span>Gratis para siempre · Sin tracking</span>
      </div>
      <h1 class="text-5xl md:text-7xl font-display font-bold text-white mb-6 animate-fade-in" style="animation-delay: 100ms;">
        <span class="text-oled-light">Creator Calendar Pro</span>
      </h1>
      <p class="text-lg md:text-2xl text-text-secondary mb-8 max-w-2xl animate-fade-in" style="animation-delay: 200ms;">
        El calendario definitivo para streamers y creadores de contenido.
        Organiza tus streams, videos y eventos con estilo OLED gaming.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in" style="animation-delay: 300ms;">
        <a href="/calendar" class="btn-primary btn-lg flex items-center justify-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          <span>Empezar Gratis</span>
        </a>
        <a href="/settings" class="btn-ghost btn-lg flex items-center justify-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
          <span>Configuración</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 bg-oled-black">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4">Todo lo que necesitas para tu calendario de streaming</h2>
        <p class="text-text-secondary">Diseñado específicamente para creadores de contenido y streamers</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {features.map(feature => `
        <div class="card-elevated p-6 rounded-2xl hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-oled-light/20 flex items-center justify-center mb-4 text-oled-light">
            <span class="text-2xl">${feature.icon}</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">${feature.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">${feature.description}</p>
        </div>
        `).join('')}
      </div>
    </div>
  </section>

  <!-- Features Grid Detailed -->
  <section class="py-16 bg-oled-dark/30">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-oled-light/20 flex items-center justify-center text-oled-light">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 12" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">Vista Semanal y Diaria</h3>
              <p class="text-text-secondary">Ve toda tu semana de streaming con franjas horarias, o enfócate en un día específico con la vista diaria detallada.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-oled-light/20 flex items-center justify-center text-oled-light">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 2v10m0 10v-10" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">Eventos Recurrentes</h3>
              <p class="text-text-secondary">Configura streams que se repiten semanal, quincenal o mensualmente. Configura una vez y olvídate.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-oled-light/20 flex items-center justify-center text-oled-light">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><line x1="9" y1="9" x2="21" y2="9" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">Exportar e Importar</h3>
              <p class="text-text-secondary">Exporta a PNG/JPG para redes, .ics para Google Calendar, o JSON para respaldo completo.</p>
            </div>
          </div>
        </div>
        <div class="relative group">
          <div class="absolute inset-0 bg-oled-dark/50 rounded-2xl blur-2xl opacity-50" />
          <div class="relative z-10">
            <div class="grid grid-cols-2 gap-2 p-4 bg-oled-dark border border-oled-neutral/30 rounded-xl shadow-xl">
              <div class="bg-oled-neutral/30 p-3 rounded-lg text-center">
                <div class="text-oled-light font-mono font-bold text-lg">7</div>
                <div class="text-xs text-text-muted">Días activos</div>
              </div>
              <div class="bg-oled-neutral/30 p-3 rounded-lg text-center">
                <div class="text-oled-light font-mono font-bold text-lg">24h</div>
                <div class="text-xs text-text-muted">Ventana de streaming</div>
              </div>
              <div class="bg-oled-neutral/30 p-3 rounded-lg text-center">
                <div class="text-oled-light font-mono font-bold text-lg">100%</div>
                <div class="text-xs text-text-muted">Gratis para siempre</div>
              </div>
              <div class="bg-oled-neutral/30 p-3 rounded-lg text-center">
                <div class="text-oled-light font-mono font-bold text-lg">∞</div>
                <div class="text-xs text-text-muted">Eventos ilimitados</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-16 bg-oled-black">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4">Precios simples y honestos</h2>
        <p class="text-text-secondary">Todo gratis. Para siempre. Porque creamos esto para la comunidad.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {pricing.map(plan => `
        <div class="card-elevated p-8 rounded-2xl ${plan.highlighted ? 'border-oled-light/50 shadow-[0_0_40px_rgba(58,123,200,0.2)]' : ''} relative">
          ${plan.highlighted ? `<div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-oled-light text-oled-black px-4 py-1 rounded-full text-xs font-bold font-mono">MÁS POPULAR</div>` : ''}
          <h3 class="text-xl font-bold text-white mb-2">${plan.name}</h3>
          <div class="flex items-baseline gap-2 mb-6">
            <span class="text-4xl font-bold text-white">${plan.price}</span>
            <span class="text-text-muted">${plan.period}</span>
          </div>
          <ul class="space-y-3 mb-8">
            ${plan.features.map(f => `
            <li class="flex items-start gap-3">
              <span class="text-oled-light">${plan.highlighted ? '✓' : '○'}</span>
              <span class="text-sm text-text-secondary">${f}</span>
            </li>
            `).join('')}
          </ul>
          ${plan.highlighted ? `<p class="text-xs text-oled-light font-mono mb-6">${plan.note}</p>` : ''}
          <a href="/calendar" class="btn-${plan.highlighted ? 'primary' : 'secondary'} w-full py-3 font-bold">
            ${plan.highlighted ? 'Empezar Gratis' : 'Empezar Gratis'}
          </a>
        </div>
        `).join('')}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-oled-black">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4">Preguntas frecuentes</h2>
        <p class="text-text-secondary">Todo lo que necesitas saber sobre Creator Calendar Pro</p>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => `
        <div class="card border-oled-neutral/30 rounded-xl p-4">
          <button class="w-full flex items-center justify-between py-3 text-left hover:text-oled-light transition-colors" onclick="this.nextElementSibling.classList.toggle('hidden')">
            <span class="text-sm font-semibold text-white">${faq.q}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <p class="text-sm text-text-secondary mt-3 hidden">${faq.a}</p>
        </div>
        `).join('')}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-br from-oled-dark to-oled-black border-t border-oled-neutral/30">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-6">¿Listo para organizar tus streams?</h2>
      <p class="text-text-secondary mb-8">Únete a cientos de creadores que ya organizan su contenido con Creator Calendar Pro.</p>
      <a href="/calendar" class="btn-primary btn-lg flex items-center justify-center gap-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        <span>Empezar Gratis</span>
      </a>
    </div>
  </section>
</Layout>