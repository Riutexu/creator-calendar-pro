---
import Layout from '@/layouts/BaseLayout.astro';

---

<Layout title="Calendario — Creator Calendar Pro">
  <header class="sticky top-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-b border-oled-neutral px-4 py-3 flex items-center justify-between" role="banner">
    <a href="/" class="btn-ghost p-2 rounded-full" aria-label="Volver al inicio">
      Back
    </a>
    <h1 class="font-display text-xl font-bold text-white flex-1 text-center">📅 Calendario Semanal</h1>
    <div class="w-10" />
  </header>

  <main class="p-4 max-w-full mx-auto pb-20" role="main">
    <div class="text-center py-20">
      <h2 class="text-2xl font-bold text-white mb-4">Calendario Semanal</h2>
      <p class="text-secondary">Organiza tus streams y eventos semanales</p>
      <button class="btn-primary btn-lg mt-6">
        <span class="text-xl">➕</span>
        <span>Nuevo Evento</span>
      </button>
    </div>
  </main>
</Layout>