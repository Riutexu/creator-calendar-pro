---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DAY_NAMES_SHORT } from '@/types';
import { getDefaultConfig } from '@/lib/calendar';

const config = getDefaultConfig();
const dayOrder = [1, 2, 3, 4, 5, 6, 0];
---

<BaseLayout
  title="Calendario compartido — Creator Calendar Pro"
  description="Calendario semanal de un creador creado con Creator Calendar Pro"
  noIndex={true}
>
  <header class="sticky top-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-b border-oled-neutral px-4 py-3 flex items-center justify-between gap-4 flex-wrap" role="banner">
    <div class="flex items-center gap-3 min-w-0">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-oled-light flex-shrink-0" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
      <div>
        <h1 class="font-display text-xl font-bold text-white truncate" id="share-title">Cargando calendario...</h1>
        <p class="text-xs text-text-muted font-mono" id="week-label">Vista de solo lectura</p>
      </div>
    </div>

    <div class="flex items-center gap-2 flex-wrap" role="navigation" aria-label="Navegación semanal">
      <button id="prev-week" class="btn-secondary" aria-label="Semana anterior" onclick="window.prevWeek?.()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6" /></svg>
        <span class="hidden sm:inline">Anterior</span>
      </button>
      <button id="today-week" class="btn-secondary" aria-label="Esta semana" onclick="window.todayWeek?.()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        <span class="hidden sm:inline">Hoy</span>
      </button>
      <button id="next-week" class="btn-secondary" aria-label="Próxima semana" onclick="window.nextWeek?.()">
        <span class="hidden sm:inline">Siguiente</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
      </button>
    </div>

    <div class="flex items-center gap-2 ml-auto" role="group" aria-label="Acciones">
      <a href="/" class="btn-primary" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 14 7 14 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
        Crear tu calendario
      </a>
    </div>
  </header>

  <main class="calendar-main p-4 pb-20 min-h-[calc(100vh-80px)]" role="main">
    <div class="grid grid-cols-calendar gap-0 overflow-hidden rounded-card border border-oled-neutral bg-oled-dark max-w-full" id="calendar-grid">
      <div class="flex-none min-w-[72px] max-w-[96px] sticky left-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-r border-oled-neutral px-2 py-2">
        <div class="flex flex-col" id="time-slots"></div>
      </div>
      <div id="day-columns"></div>
    </div>
  </main>

  <footer class="fixed bottom-0 left-0 right-0 bg-oled-black/95 backdrop-blur-sm border-t border-oled-neutral px-4 py-3 text-center text-xs text-text-muted" role="contentinfo">
    Creado con <a href="/" class="text-oled-light hover:underline" target="_blank" rel="noopener">Creator Calendar Pro</a> — Gratis, open source, sin tracking
  </footer>
</BaseLayout>

<script type="module">
  import '@/client/shared.ts';
</script>