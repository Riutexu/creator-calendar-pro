---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIG } from '@/types';

const config = DEFAULT_CONFIG;
---

<BaseLayout
  title="Configuración — Creator Calendar Pro"
  description="Configura tus días de stream, ventana horaria, API Key de SteamGridDB y exporta/importa tu calendario."
  noIndex={true}
  canonicalURL="https://riutexu.github.io/creator-calendar-pro/settings"
>
  <header class="sticky top-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-b border-oled-neutral px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="btn-ghost p-2 rounded-full" aria-label="Volver al calendario">
      Back
    </a>
    <h1 class="font-display text-xl font-bold text-white flex-1 text-center">⚙️ Configuración</h1>
    <div class="w-10" />
  </header>

  <main class="p-4 max-w-2xl mx-auto space-y-6 pb-20" role="main">
    <form id="settings-form" class="space-y-6">
      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Días de Stream</h3>
        <p class="text-xs text-text-muted">Click para activar/desactivar.</p>
        <div class="flex flex-wrap gap-2">
          ${[1,2,3,4,5,6,0].map(day => {
            const names = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
            return `<button type="button" class="pill pill-tag transition-all min-w-[56px]" data-day="${day}" aria-pressed="false">
              ${names[day]}
            </button>`;
          }).join('')}
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Ventana de Streaming</legend>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="label" for="window-start">Inicio</label>
            <input type="time" id="window-start" class="input" value="18:00" />
          </div>
          <div>
            <label class="label" for="window-end">Fin</label>
            <input type="time" id="window-end" class="input" value="02:00" />
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Cuenta y Perfil</legend>
        <div>
          <label class="label" for="username">Nombre de usuario</label>
          <input type="text" id="username" class="input" placeholder="tuusuario" maxlength="30" pattern="[a-zA-Z0-9_-]+" value="" />
          <p class="text-xs text-text-muted mt-1">Se usa en links compartidos: creator-calendar.pro/@tuusuario</p>
        </div>
        <div>
          <label class="label" for="timezone">Zona horaria</label>
          <select id="timezone" class="input">
            <option value="Europe/Madrid">Europe/Madrid (UTC+1/+2)</option>
            <option value="Europe/Paris">Europe/Paris (UTC+1/+2)</option>
            <option value="Europe/Berlin">Europe/Berlin (UTC+1/+2)</option>
            <option value="America/Mexico_City">America/Mexico_City (UTC-6/-5)</option>
            <option value="America/Bogota">America/Bogota (UTC-5)</option>
            <option value="America/Argentina/Buenos_Aires">America/Argentina/Buenos_Aires (UTC-3)</option>
            <option value="UTC">UTC</option>
          </select>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Exportar e Importar</legend>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" class="btn-secondary" onclick="window.exportJSON?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            Exportar JSON
          </button>
          <button type="button" class="btn-secondary" onclick="window.downloadICS?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            Descargar .ics
          </button>
          <button type="button" class="btn-secondary" onclick="window.generateShareLink?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.58" y2="10.49" /></svg>
            Generar Link
          </button>
          <button type="button" class="btn-secondary" onclick="window.exportImage?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
            Exportar PNG
          </button>
        </div>
        <div>
          <label class="label" for="import-file">Importar JSON</label>
          <input type="file" id="import-file" class="input file:mr-4 file:py-2 file:px-4 file:rounded-card-sm file:border-0 file:text-sm file:font-mono file:bg-oled-light file:text-oled-black hover:file:bg-opacity-90" accept=".json" />
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Datos y Privacidad</legend>
        <div class="p-3 bg-oled-neutral/30 border border-oled-neutral rounded-card-sm text-sm text-text-secondary space-y-2">
          <p><strong>100% Local &amp; Privado:</strong> Todos tus datos se guardan en tu navegador (IndexedDB). Nada se envía a servidores externos.</p>
          <p><strong>SteamGridDB:</strong> Solo se conecta a <code class="font-mono bg-oled-black px-1 rounded">api.steamgriddb.com</code> para buscar portadas. Tu API Key nunca sale de tu dispositivo.</p>
          <p><strong>Sin tracking:</strong> Sin Google Analytics, sin cookies de terceros, sin fingerprinting.</p>
          <p><strong>Backup automático:</strong> Exporta JSON periódicamente para tener copia de seguridad.</p>
        </div>
        <div class="flex gap-2">
          <button type="button" class="btn-danger flex-1" onclick="window.clearAllData?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2 2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
            Borrar Todo
          </button>
        </div>
      </fieldset>
    </form>
  </main>
</BaseLayout>

<script type="module">
  import { getConfig, saveConfig, getAllEvents } from '@/lib/idb';
  import { validateConfig } from '@/lib/calendar';
  import { createSteamGridDBClient } from '@/lib/steamgriddb';
  import { toastSuccess, toastError, toastInfo } from '@/lib/toast';

  interface CreatorConfig {
    activeDays: number[];
    streamingWindow: { start: string; end: string };
    timezone: string;
    username: string;
    steamGridDbKey?: string;
    id?: string;
  }

  interface CalendarConfig extends Omit<CreatorConfig, 'username'> {
    username: string;
  }

  const config: CalendarConfig = {
    activeDays: [1, 2, 5, 0],
    streamingWindow: { start: '18:00', end: '02:00' },
    timezone: 'Europe/Madrid',
    username: '',
    steamGridDbKey: undefined,
    id: '',
  };

  function updateActiveDaysUI(activeDays: number[]) {
    document.querySelectorAll('[data-day]').forEach(btn => {
      const day = parseInt(btn.getAttribute('data-day')!);
      const isActive = activeDays.includes(day);
      btn.classList.toggle('pill-active-day', isActive);
      btn.classList.toggle('pill-inactive-day', !isActive);
      btn.setAttribute('aria-pressed', String(isActive));
      const indicator = btn.querySelector('span:last-child') as HTMLElement;
      if (indicator) {
        indicator.className = \`w-2 h-2 rounded-full \${isActive ? 'bg-oled-light' : 'bg-oled-neutral'}\`;
      }
    });
  }

  (window as any).toggleActiveDay = async (day: number) => {
    const cfg = (await getConfig()) as CalendarConfig | undefined || config;
    const newActiveDays = cfg.activeDays.includes(day)
      ? cfg.activeDays.filter(d => d !== day)
      : [...cfg.activeDays, day].sort((a, b) => a - b);

    await saveConfig({ ...cfg, activeDays: newActiveDays } as CalendarConfig);
    toastSuccess?.(newActiveDays.includes(day) ? 'Día activado' : 'Día desactivado');
    updateActiveDaysUI(newActiveDays);
  };

  (window as any).updateStreamingWindow = async (window_: { start: string; end: string }) => {
    const cfg = (await getConfig()) as CalendarConfig | undefined || config;
    const validation = validateConfig({ streamingWindow: window_ });
    if (!validation.valid) {
      toastError?.(validation.errors[0]);
      return;
    }

    await saveConfig({ ...cfg, streamingWindow: window_ } as CalendarConfig);
    toastSuccess?.('Horario actualizado');
  };

  (window as any).saveApiKey = async (key: string) => {
    const cfg = (await getConfig()) as CalendarConfig | undefined || config;
    await saveConfig({ ...cfg, steamGridDbKey: key.trim() } as CalendarConfig);
    toastSuccess?.('API Key guardada');
  };

  (window as any).testApiKey = async () => {
    const input = document.getElementById('api-key') as HTMLInputElement;
    const statusEl = document.getElementById('api-key-status') as HTMLElement;
    const testBtn = document.querySelector('button[onclick="window.testApiKey?.()"]') as HTMLButtonElement;

    const key = input.value.trim();
    if (!key) {
      toastError?.('Ingresa una API Key primero');
      return;
    }

    testBtn.disabled = true;
    testBtn.innerHTML = '<svg class="animate-spin-slow w-18 h-18 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.25" /><path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1" stroke-linecap="round" /></svg> Probando...';

    try {
      const client = createSteamGridDBClient(key);
      const result = await client.testConnection();

      if (result.valid) {
        statusEl.textContent = '✅ ' + result.message;
        statusEl.className = 'text-xs text-emerald-400 min-h-[20px]';
        toastSuccess?.('Conexión exitosa');
      } else {
        statusEl.textContent = '❌ ' + result.message;
        statusEl.className = 'text-xs text-rose-400 min-h-[20px]';
        toastError?.(result.message);
      }
    } catch (error) {
      statusEl.textContent = '❌ Error de conexión';
      statusEl.className = 'text-xs text-rose-400 min-h-[20px]';
      toastError?.('Error al probar la conexión');
    } finally {
      testBtn.disabled = false;
      testBtn.textContent = 'Probar Conexión';
    }
  };

  (window as any).exportJSON = async () => {
    const cfg = await getConfig();
    const events = await getAllEvents();
    exportToJSON(cfg!, events, cfg?.username);
    toastSuccess?.('JSON exportado');
  };

  (window as any).downloadICS = async () => {
    const cfg = await getConfig();
    const events = await getAllEvents();
    await downloadICS(events, cfg!, cfg?.username);
    toastSuccess?.('Archivo .ics descargado');
  };

  (window as any).generateShareLink = async () => {
    const cfg = await getConfig();
    const events = await getAllEvents();
    const { url, qrCodeDataUrl } = await generateShareLink(cfg!, events, cfg?.username);

    const modal = document.getElementById('settings-share-modal');
    if (modal) {
      (modal as any)._show?.(url, qrCodeDataUrl, cfg?.username);
    }
  };

  (window as any).exportImage = () => {
    document.getElementById('export-image-btn')?.click();
  };

  (window as any).clearAllData = async () => {
    if (!confirm('⚠️ Esto borrará TODOS tus eventos y configuración. ¿Estás seguro?')) return;
    if (!confirm('Última confirmación: ¿Borrar todo irrevocablemente?')) return;

    const db = await getDB();
    await db.clear('events');
    await db.clear('config');
    await db.clear('shares');
    await db.clear('cache');

    toastSuccess?.('Todos los datos borrados');
    setTimeout(() => location.reload(), 1000);
  };

  (document.addEventListener('DOMContentLoaded', async () => {
    const cfg = (await getConfig()) as CalendarConfig | undefined || config;
    updateActiveDaysUI(cfg.activeDays);
  }));
</script>