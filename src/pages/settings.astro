---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIG } from '@/types';
import ActiveDaysToggle from '@/components/Settings/ActiveDaysToggle.astro';
import StreamingWindow from '@/components/Settings/StreamingWindow.astro';
import ApiKeyInput from '@/components/Settings/ApiKeyInput.astro';
import ShareModal from '@/components/Modals/ShareModal.astro';

const config = DEFAULT_CONFIG;
---

<BaseLayout
  title="Configuración — Creator Calendar Pro"
  description="Configura tus días de stream, ventana horaria, API Key de SteamGridDB y exporta/importa tu calendario."
  noIndex={true}
  canonicalURL="https://riutexu.github.io/creator-calendar-pro/settings"
>
  <header class="sticky top-0 z-sticky bg-oled-black/95 backdrop-blur-sm border-b border-oled-neutral px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="btn-ghost p-2 rounded-full" aria-label="Volver al calendario">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <h1 class="font-display text-xl font-bold text-white flex-1 text-center">⚙️ Configuración</h1>
    <div class="w-10" />
  </header>

  <main class="p-4 max-w-2xl mx-auto space-y-6 pb-20" role="main">
    <form id="settings-form" class="space-y-6">
      <ActiveDaysToggle activeDays={config.activeDays} onToggleDay={(day) => window.toggleActiveDay?.(day)} />

      <StreamingWindow streamingWindow={config.streamingWindow} onChange={(w) => window.updateStreamingWindow?.(w)} />

      <ApiKeyInput
        apiKey={config.steamGridDbKey}
        onSave={(key) => window.saveApiKey?.(key)}
        onTest={() => window.testApiKey?.()}
      />

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Cuenta y Perfil</legend>
        <div>
          <label class="label" for="username">Nombre de usuario</label>
          <input
            type="text"
            id="username"
            class="input"
            placeholder="tuusuario (para links compartidos)"
            value={config.username || ''}
            maxlength="30"
            pattern="[a-zA-Z0-9_-]+"
          />
          <p class="text-xs text-text-muted mt-1">Se usa en links compartidos: creator-calendar.pro/@tuusuario</p>
        </div>
        <div>
          <label class="label" for="timezone">Zona horaria</label>
          <select id="timezone" class="input">
            <option value="Europe/Madrid" selected={config.timezone === 'Europe/Madrid'}>Europe/Madrid (UTC+1/+2)</option>
            <option value="Europe/Paris" selected={config.timezone === 'Europe/Paris'}>Europe/Paris (UTC+1/+2)</option>
            <option value="Europe/Berlin" selected={config.timezone === 'Europe/Berlin'}>Europe/Berlin (UTC+1/+2)</option>
            <option value="America/Mexico_City" selected={config.timezone === 'America/Mexico_City'}>America/Mexico_City (UTC-6/-5)</option>
            <option value="America/Bogota" selected={config.timezone === 'America/Bogota'}>America/Bogota (UTC-5)</option>
            <option value="America/Argentina/Buenos_Aires" selected={config.timezone === 'America/Argentina/Buenos_Aires'}>America/Argentina/Buenos_Aires (UTC-3)</option>
            <option value="UTC" selected={config.timezone === 'UTC'}>UTC</option>
          </select>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Exportar e Importar</legend>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" class="btn-secondary" onclick="window.exportJSON?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            Exportar JSON
          </button>
          <button type="button" class="btn-secondary" onclick="window.downloadICS?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            Descargar .ics
          </button>
          <button type="button" class="btn-secondary" onclick="window.generateShareLink?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.58" y2="10.49" /></svg>
            Generar Link
          </button>
          <button type="button" class="btn-secondary" onclick="window.exportImage?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
            Exportar PNG
          </button>
        </div>
        <div>
          <label class="label" for="import-file">Importar JSON</label>
          <input
            type="file"
            id="import-file"
            class="input file:mr-4 file:py-2 file:px-4 file:rounded-card-sm file:border-0 file:text-sm file:font-mono file:bg-oled-light file:text-oled-black hover:file:bg-opacity-90"
            accept=".json"
            onchange="window.importJSON?.(this.files?.[0])"
          />
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-oled-neutral pt-6">
        <legend class="label">Datos y Privacidad</legend>
        <div class="p-3 bg-oled-neutral/30 border border-oled-neutral rounded-card-sm text-sm text-text-secondary space-y-2">
          <p><strong>100% Local & Privado:</strong> Todos tus datos (eventos, configuración, API Key) se guardan en <code class="font-mono bg-oled-black px-1 rounded">IndexedDB</code> de tu navegador. Nada se envía a servidores externos.</p>
          <p><strong>SteamGridDB:</strong> Solo se conecta a <code class="font-mono bg-oled-black px-1 rounded">api.steamgriddb.com</code> para buscar portadas. Tu API Key nunca sale de tu dispositivo.</p>
          <p><strong>Sin tracking:</strong> Sin Google Analytics, sin cookies de terceros, sin fingerprinting. Solo tú tienes acceso a tus datos.</p>
          <p><strong>Backup automático:</strong> Exporta JSON periódicamente para tener copia de seguridad.</p>
        </div>
        <div class="flex gap-2">
          <button type="button" class="btn-danger flex-1" onclick="window.clearAllData?.()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
            Borrar Todo
          </button>
        </div>
      </fieldset>
    </form>
  </main>

  <ShareModal
    id="settings-share-modal"
    isOpen={false}
    shareUrl=""
    qrCodeDataUrl=""
    username={config.username}
    onClose={() => window.closeShareModal?.()}
    onCopyLink={() => window.copyShareLink?.()}
    onDownloadICS={() => window.downloadICS?.()}
    onExportImage={() => window.exportImage?.()}
    onExportJSON={() => window.exportJSON?.()}
  />
</BaseLayout>

<script type="module">
  import '@/client/settings.ts';
</script>