{
  "name": "creator-calendar-pro",
  "type": "module",
  "version": "2.0.0",
  "description": "Calendario semanal OLED para creadores de contenido - Gratis, open source, sin tracking",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .astro,.ts,.js",
    "format": "prettier --write src/**/*.{astro,ts,js,css,json,md}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "date-fns": "^3.6.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@types/html2canvas": "^1.0.0",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-import-url": "^7.4.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@playwright/test": "^1.42.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "calendar",
    "creator",
    "streamer",
    "oled",
    "gaming",
    "steamgriddb",
    "pwa",
    "offline-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/creator-calendar-pro.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/creator-calendar-pro/issues"
  },
  "homepage": "https://tu-usuario.github.io/creator-calendar-pro/"
}